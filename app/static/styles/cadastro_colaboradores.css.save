body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    margin: 0;
    display: flex;
    justify-content: center;
    /* ❌ remover align-items: center */
    /* ❌ remover height: 100vh */
    min-height: 100vh;             /* permite crescer mais que a viewport */
    overflow-y: auto;              /* ativa rolagem da página */
    padding: 30px 0;               /* respiro superior e inferior

.container {
    background-color: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    width: 400px;
    text-align: center;
    position: relative;
    max-height: none;              /* deixa crescer conforme conteúdo */
}

/* 🔧 adiciona rolagem só dentro da área de projetos */
.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
    align-items: flex-start;
    text-align: left;
}

/* nova caixa de rolagem para os projetos */
.checkbox-scroll {
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 10px;
    max-height: 360px;             /* limite da caixa */
    overflow-y: auto;
    background: #fff;
}

/* itens de checkbox */
.checkbox-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.checkbox-item input[type="checkbox"] {
    transform: scale(1.1);
    cursor: pointer;
    margin: 0;
}

/* demais estilos mantidos */
.title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

.btn-voltar {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: red;
    color: white;
    padding: 8px 12px;
    border-radius: 5px;
    text-decoration: none;
}

.btn-voltar:hover {
    background-color: darkred;
}

.btn-colaboradores {
    background-color: #90ee90;
    border: none;
    padding: 10px 20px;
    font-size: 18px;
    border-radius: 5px;
    cursor: default;
    margin-bottom: 15px;
}

.form-group {
    margin-bottom: 15px;
    text-align: left;
}

label {
    display: block;
    font-weight: bold;
    margin-bottom: 5px;
}

input, select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
}

.botoes {
    margin-top: 15px;
}

.btn-salvar {
    background-color: green;
    color: white;
    padding: 10px 15px;
    border: none;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
}

.btn-salvar:hover {
    background-color: darkgreen;
}

